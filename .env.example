# Copy to .env (git-ignored). Values below match docker-compose.yml.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/cdevi
DATABASE_MIGRATOR_URL=postgres://migrator:migrator@localhost:5432/cdevi
SESSION_SECRET=change-me-32-bytes-minimum-for-local-development-only
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
CDEVI_ENV=development
CDEVI_RLS=off
# Shared secret for the inbound Jira webhook (x-hub-signature = sha256=<HMAC-SHA256(secret, raw body)>).
# Unset ⇒ POST /api/integrations/jira/webhook answers 401. Generate one: openssl rand -hex 32
JIRA_WEBHOOK_SECRET=change-me

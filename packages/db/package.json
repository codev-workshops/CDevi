{
  "name": "@cdevi/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle), SQL migrations, deterministic seed and admin CLIs for CDevi.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./password": "./src/password.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "user:create": "tsx src/cli/user-create.ts",
    "ingest-key:create": "tsx src/cli/ingest-key-create.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cdevi/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}

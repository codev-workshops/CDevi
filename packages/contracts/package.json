{
  "name": "@cdevi/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas, OpenAPI document and pure Inbox read-model rules shared by @cdevi/api and @cdevi/web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts",
    "./read-model": "./src/read-model.ts",
    "./decision-rules": "./src/decision-rules.ts",
    "./dashboard-model": "./src/dashboard-model.ts",
    "./vocabulary": "./src/vocabulary.ts",
    "./requirement-rules": "./src/requirement-rules.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi": "tsx scripts/write-openapi.ts"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  }
}

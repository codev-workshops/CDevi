{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "CDevi (සීදේවි)",
  "version": "1.1.0",
  "color": {
    "canvas": { "$type": "color", "$value": "#F3F4F6", "$extensions": { "cdevi.dark": "#0F1218" } },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$extensions": { "cdevi.dark": "#171B23" }
    },
    "surface-2": {
      "$type": "color",
      "$value": "#F8F9FB",
      "$extensions": { "cdevi.dark": "#1D222C" }
    },
    "ink": { "$type": "color", "$value": "#171A21", "$extensions": { "cdevi.dark": "#E6E9EF" } },
    "ink-2": { "$type": "color", "$value": "#4A5262", "$extensions": { "cdevi.dark": "#B3BAC7" } },
    "ink-3": {
      "$type": "color",
      "$value": "#656D7D",
      "$description": "Tertiary text. Darkened from #7C8494 in 1.1.0 to reach 4.5:1 on canvas and surface.",
      "$extensions": { "cdevi.dark": "#8790A0" }
    },
    "line": { "$type": "color", "$value": "#E1E4EA", "$extensions": { "cdevi.dark": "#2A303C" } },
    "line-2": { "$type": "color", "$value": "#CED3DC", "$extensions": { "cdevi.dark": "#3A414E" } },
    "line-strong": {
      "$type": "color",
      "$value": "#808A9A",
      "$description": "Border for controls that must be identifiable (inputs, ghost buttons, radios, checkboxes): 3:1 against surface (WCAG 1.4.11).",
      "$extensions": { "cdevi.dark": "#6B7587" }
    },
    "saffron": {
      "$type": "color",
      "$value": "#C9791B",
      "$extensions": { "cdevi.dark": "#E39A3B" }
    },
    "saffron-soft": {
      "$type": "color",
      "$value": "#FBEFDF",
      "$extensions": { "cdevi.dark": "#3A2A14" }
    },
    "saffron-ink": {
      "$type": "color",
      "$value": "#8A4F0B",
      "$extensions": { "cdevi.dark": "#F3C282" }
    },
    "saffron-strong": {
      "$type": "color",
      "$value": "#A8620F",
      "$description": "Saffron fill that carries white text at AA (primary saffron button, critical risk badge).",
      "$extensions": { "cdevi.dark": "#9E5C0E" }
    },
    "indigo": { "$type": "color", "$value": "#2F4FD6", "$extensions": { "cdevi.dark": "#8FA3FF" } },
    "indigo-soft": {
      "$type": "color",
      "$value": "#E6EBFB",
      "$extensions": { "cdevi.dark": "#1F2748" }
    },
    "green": {
      "$type": "color",
      "$value": "#1A6E50",
      "$description": "Verified / evidence. Darkened from #1E7F5C in 1.1.0 to reach 4.5:1 on green-soft.",
      "$extensions": { "cdevi.dark": "#4CC48F" }
    },
    "green-soft": {
      "$type": "color",
      "$value": "#DFF3EA",
      "$extensions": { "cdevi.dark": "#153426" }
    },
    "red": { "$type": "color", "$value": "#B23A48", "$extensions": { "cdevi.dark": "#F08A96" } },
    "red-soft": {
      "$type": "color",
      "$value": "#F9E3E6",
      "$extensions": { "cdevi.dark": "#3E1F25" }
    },
    "code-bg": {
      "$type": "color",
      "$value": "#1A1E27",
      "$extensions": { "cdevi.dark": "#0B0E14" }
    },
    "code-ink": {
      "$type": "color",
      "$value": "#D8DDE6",
      "$extensions": { "cdevi.dark": "#D8DDE6" }
    },
    "code-read": {
      "$type": "color",
      "$value": "#8FA3C7",
      "$description": "Tool log: read-only operations."
    },
    "code-write": {
      "$type": "color",
      "$value": "#E9C46A",
      "$description": "Tool log: write operations."
    },
    "code-ok": {
      "$type": "color",
      "$value": "#7BD3A8",
      "$description": "Tool log / terminal: success."
    },
    "code-err": {
      "$type": "color",
      "$value": "#F49AA6",
      "$description": "Tool log / terminal: error."
    },
    "code-dim": {
      "$type": "color",
      "$value": "#9AA3B2",
      "$description": "Tool log / terminal: secondary text. Lightened from #6B7280 in 1.1.0 for AA on code-bg."
    }
  },
  "font": {
    "ui": {
      "$type": "fontFamily",
      "$value": ["Instrument Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
      "$extensions": { "cdevi.cssVar": "--ui" }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"],
      "$extensions": { "cdevi.cssVar": "--mono" }
    },
    "sinhala": {
      "$type": "fontFamily",
      "$value": ["Noto Sans Sinhala", "Instrument Sans", "sans-serif"],
      "$extensions": { "cdevi.cssVar": "--sinhala" }
    }
  },
  "radius": {
    "md": { "$type": "dimension", "$value": "8px", "$extensions": { "cdevi.cssVar": "--r" } },
    "lg": { "$type": "dimension", "$value": "12px", "$extensions": { "cdevi.cssVar": "--r-lg" } },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "text": {
    "xs": { "$type": "dimension", "$value": "11.5px" },
    "sm": { "$type": "dimension", "$value": "12.5px" },
    "base": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "2xl": { "$type": "dimension", "$value": "24px" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 0 rgba(0,0,0,.04)" }
  },
  "semantic": {
    "needs-you": {
      "$value": "{color.saffron}",
      "$description": "Anything that needs a person; also the single primary action on a screen."
    },
    "primary-action": {
      "$value": "{color.saffron}",
      "$description": "The one primary action on a screen (DR-02)."
    },
    "running": { "$value": "{color.indigo}", "$description": "Work in progress and links." },
    "verified": { "$value": "{color.green}", "$description": "Platform-verified outcome." },
    "failed": { "$value": "{color.red}", "$description": "Failure, or a secret detected." },
    "evidence": { "$value": "{color.green}", "$description": "Evidence rows with a source." },
    "state": {
      "queued": {
        "$value": "{color.ink-2}",
        "$description": "Workflow state QUEUED: waiting to start; neutral pill."
      },
      "running": {
        "$value": "{color.indigo}",
        "$description": "Workflow state RUNNING: agent working; pulsing run pill."
      },
      "waiting": {
        "$value": "{color.saffron-ink}",
        "$description": "Workflow state WAITING: waiting on a system; wait pill."
      },
      "waiting-for-human": {
        "$value": "{color.saffron}",
        "$description": "Workflow state WAITING_FOR_HUMAN: needs a person now; never hidden."
      },
      "blocked": {
        "$value": "{color.red}",
        "$description": "Workflow state BLOCKED: cannot continue without intervention; never hidden. Distinct from failed."
      },
      "failed": {
        "$value": "{color.red}",
        "$description": "Workflow state FAILED: stage failed; fail pill."
      },
      "retrying": {
        "$value": "{color.indigo}",
        "$description": "Workflow state RETRYING: automatic retry in progress; run pill."
      },
      "completed": {
        "$value": "{color.green}",
        "$description": "Workflow state COMPLETED: done and verified; done pill."
      },
      "cancelled": {
        "$value": "{color.ink-3}",
        "$description": "Workflow state CANCELLED: stopped by a person; neutral pill, struck through."
      }
    },
    "risk": {
      "low": { "$value": "{color.ink-2}", "$description": "Risk LOW: read repository, run tests." },
      "medium": {
        "$value": "{color.indigo}",
        "$description": "Risk MEDIUM: modify code, create PR, create issue."
      },
      "high": {
        "$value": "{color.saffron-ink}",
        "$description": "Risk HIGH: merge PR, modify infrastructure, deploy staging. Visually prominent."
      },
      "critical": {
        "$value": "{color.saffron-strong}",
        "$description": "Risk CRITICAL: deploy production, modify production database, change security policy. Most prominent; not the failed treatment."
      }
    }
  }
}

{
  "name": "@cdevi/design-system",
  "version": "1.5.0",
  "description": "CDevi (සීදේවි) design tokens, CSS and accessible React components.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "tokens",
    "tailwind",
    "README.md",
    "CHANGELOG.md",
    "DESIGN.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./css/cdevi.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./css/cdevi.css",
    "./css/tokens": "./css/tokens.css",
    "./css/fonts": "./css/fonts.css",
    "./tokens.json": "./tokens/tokens.json",
    "./tailwind/preset": "./tailwind/preset.cjs"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:lib": "vite build",
    "build": "pnpm build:tokens && pnpm build:css && pnpm build:lib",
    "gallery": "vite --config vite.gallery.config.ts",
    "gallery:build": "vite build --config vite.gallery.config.ts",
    "gallery:preview": "vite preview --config vite.gallery.config.ts --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:visual": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sinhala": "5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0",
    "vitest": "4.1.11"
  }
}
